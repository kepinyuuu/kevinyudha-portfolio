# ==============================================================================
# Environment Variables for Vercel (FrankenPHP Container)
# Set these in Vercel Project Settings > Environment Variables.
# JANGAN commit file ini dengan nilai rahasia yang sebenarnya.
# ==============================================================================

APP_NAME="Kevin Yudha Pratama Portfolio"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-project.vercel.app

# ── Writable paths (Vercel filesystem read-only di luar /tmp) ─────────────────
APP_STORAGE_PATH=/tmp/storage
VIEW_COMPILED_PATH=/tmp/storage/framework/views

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_CHANNEL=stderr

# ── Database (MySQL — PlanetScale / TiDB / Aiven / RDS / dll.) ────────────────
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ── Session & Cache (persisten via database, bukan file) ──────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
CACHE_STORE=database

# ── Object Storage (S3-compatible / Cloudflare R2) ────────────────────────────
# FILESYSTEM_DISK harus s3 agar upload gambar tersimpan di cloud storage,
# bukan di filesystem container yang ephemeral.
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Admin Credentials (untuk database seeder awal) ───────────────────────────
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
