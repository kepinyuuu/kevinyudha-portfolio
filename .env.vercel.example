# ==============================================================================
# Environment Configuration for Vercel (FrankenPHP Container)
# Set these in your Vercel Project Settings > Environment Variables
# Mode Default: Tanpa Database Eksternal & Tanpa Disk S3/R2
# ==============================================================================

APP_NAME="Kevin Yudha Pratama Portfolio"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-portfolio.vercel.app

# ── Writable Container Paths (Vercel container read-only di luar /tmp) ────────
APP_STORAGE_PATH=/tmp/storage
VIEW_COMPILED_PATH=/tmp/storage/framework/views

# ── Logging (Mengalir langsung ke Vercel Runtime Logs) ─────────────────────────
LOG_CHANNEL=stderr

# ── Session & Cache (Stateless / File /tmp, tidak memerlukan DB) ───────────────
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
CACHE_STORE=file

# ── Filesystem (Public / Lokal, tidak memerlukan S3/R2) ────────────────────────
FILESYSTEM_DISK=public

# ── Database (Default SQLite di /tmp; tidak wajib memiliki database eksternal) ─
# Portfolio dapat membaca langsung dari config/portfolio.php tanpa DB.
DB_CONNECTION=sqlite
DB_DATABASE=/tmp/storage/database.sqlite

# ── [OPSIONAL] Database Eksternal (MySQL / PostgreSQL) ────────────────────────
# Aktifkan jika Anda ingin menghubungkan database cloud (PlanetScale, Supabase, Neon, TiDB):
# DB_CONNECTION=mysql
# DB_HOST=
# DB_PORT=3306
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=
# SESSION_DRIVER=database
# CACHE_STORE=database

# ── [OPSIONAL] Object Storage (Cloudflare R2 / AWS S3) ─────────────────────────
# Aktifkan jika Anda ingin upload gambar dari dashboard admin tersimpan di cloud storage:
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=auto
# AWS_BUCKET=
# AWS_ENDPOINT=
# AWS_URL=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# ── [OPSIONAL] Admin Credentials (untuk inisialisasi akun admin jika pakai DB) ─
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── [OPSIONAL] Kontak Email ───────────────────────────────────────────────────
MAIL_TO_ADDRESS=
